<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pos_receipt_list" model="ir.ui.view">
        <field name="name">pos.receipt.list</field>
        <field name="model">pos.receipt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pos_order_id"/>
                <field name="receipt_number"/>
                <field name="state"/>
                <field name="created_at"/>
                <field name="signed_at"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_pos_receipt_form" model="ir.ui.view">
        <field name="name">pos.receipt.form</field>
        <field name="model">pos.receipt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,signed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Receipt Information">
                            <field name="pos_order_id"/>
                            <field name="receipt_id"/>
                            <field name="receipt_number"/>
                        </group>
                        <group string="Timing">
                            <field name="created_at"/>
                            <field name="signed_at"/>
                            <field name="formatted_time_signature"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cash Register">
                            <field name="cash_register_serial"/>
                        </group>
                        <group string="Status">
                            <field name="is_offline_receipt"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="QR Code Data">
                            <field name="qr_code_data" readonly="1"/>
                        </page>
                        <page string="Fiskaly Response">
                            <field name="fiskaly_response" readonly="1"/>
                        </page>
                        <page string="Error Information">
                            <field name="error_message" readonly="1"/>
                        </page>
                        <page string="Schema Data">
                            <field name="schema_data" readonly="1"/>
                        </page>
                        <page string="Request Payload">
                            <field name="request_payload" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_pos_receipt_search" model="ir.ui.view">
        <field name="name">pos.receipt.search</field>
        <field name="model">pos.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pos_order_id"/>
                <field name="receipt_number"/>
                <field name="state"/>
                <field name="created_at"/>
                <filter string="Signed" name="signed" domain="[('state', '=', 'signed')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Offline" name="offline" domain="[('is_offline_receipt', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'created_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pos_receipt" model="ir.actions.act_window">
        <field name="name">POS Receipts</field>
        <field name="res_model">pos.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first POS receipt!
            </p>
        </field>
    </record>

    <!-- Menu Item - Under POS Orders -->
    <menuitem id="menu_pos_receipt"
              name="Receipts"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_receipt"
              sequence="20"/>
</odoo> 