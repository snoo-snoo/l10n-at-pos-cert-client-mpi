<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Company Form View -->
        <record id="res_company_form_view_pos_cert" model="ir.ui.view">
            <field name="name">res.company.form.pos.cert</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="POS Certification" name="pos_certification">
                        <group>
                            <group string="Configuration">
                                <field name="pos_cert_admin_url"/>
                                <field name="pos_cert_api_key"/>
                            </group>
                            <group string="Status">
                                <field name="pos_cert_status" readonly="1"/>
                                <field name="l10n_at_fiskaly_organization_status" readonly="1"/>
                                <field name="l10n_at_fiskaly_organization_error" invisible="not l10n_at_fiskaly_organization_error"/>
                            </group>
                        </group>
                        <group>
                            <button name="create_fiskaly_organization" 
                                    string="Create Fiskaly Organization" 
                                    type="object" 
                                    class="btn-primary"
                                    invisible="pos_cert_status != 'active' or l10n_at_fiskaly_organization_status == 'created' or l10n_at_fiskaly_organization_status == 'creating'"/>
                            <button name="action_subscribe_to_pos_cert" 
                                    string="Subscribe to POS Certification" 
                                    type="object" 
                                    class="btn-secondary"
                                    invisible="pos_cert_status != 'inactive'"/>
                            <button name="cancel_plan" 
                                    string="Cancel Plan" 
                                    type="object" 
                                    class="btn-danger"
                                    invisible="pos_cert_status == 'inactive'"/>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="pos_cert_status != 'active'">
                            <strong>Note:</strong> Click "Create Fiskaly Organization" to set up your Austrian fiscal compliance.
                        </div>
                        
                        <!-- Fiskaly FON Authentication Section -->
                        <group string="Fiskaly FON Authentication" invisible="pos_cert_status != 'active'">
                            <group string="FON Credentials">
                                <field name="l10n_at_fiskaly_fon_participant_id"/>
                                <field name="l10n_at_fiskaly_fon_user_id"/>
                                <field name="l10n_at_fiskaly_fon_user_pin"/>
                            </group>
                            <group string="Authentication Status">
                                <field name="l10n_at_fiskaly_fon_authentication_status" readonly="1"/>
                                <field name="l10n_at_fiskaly_fon_authentication_date" readonly="1"/>
                                <field name="l10n_at_fiskaly_fon_authentication_error" readonly="1" invisible="not l10n_at_fiskaly_fon_authentication_error"/>
                            </group>
                        </group>
                        <group invisible="pos_cert_status != 'active'">
                            <button name="action_authenticate_fon" 
                                    string="Authenticate FON" 
                                    type="object" 
                                    class="btn-primary"
                                    invisible="l10n_at_fiskaly_fon_authentication_status == 'authenticated'"/>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="pos_cert_status != 'active'">
                            <strong>FON Authentication:</strong> Enter your FinanzOnline credentials and click "Authenticate FON" to complete the Austrian fiscal compliance setup.
                        </div>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 