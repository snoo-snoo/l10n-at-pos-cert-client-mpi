<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Company Form View - POS Certification Tab -->
        <record id="view_company_form_inherit_pos_cert" model="ir.ui.view">
            <field name="name">res.company.form.inherit.pos.cert</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="POS Certification" name="pos_certification">
                        <group>
                            <group string="Status">
                                <field name="pos_cert_status" readonly="1"/>
                            </group>
                            <group string="Configuration">
                                <field name="pos_cert_enabled"/>
                                <button name="action_select_subscription_plan" 
                                        string="Select Plan" 
                                        type="object" 
                                        class="btn-primary"
                                        icon="fa-list"/>
                            </group>
                        </group>
                        <group>
                            <group string="Admin Module">
                                <field name="pos_cert_admin_url"/>
                                <field name="pos_cert_api_key"/>
                            </group>
                            <group string="Client Instance">
                                <field name="pos_cert_client_url"/>
                                <field name="pos_cert_webhook_url" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Selected Plan">
                                <field name="pos_cert_selected_plan_name" readonly="1"/>
                                <field name="pos_cert_selected_plan_price" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 