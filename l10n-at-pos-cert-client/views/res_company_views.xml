<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Company Form View -->
        <record id="res_company_form_view_pos_cert" model="ir.ui.view">
            <field name="name">res.company.form.pos.cert</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="POS Certification" name="pos_certification">
                        <group>
                            <group string="Configuration">
                                <field name="pos_cert_admin_url"/>
                                <field name="pos_cert_api_key"/>
                            </group>
                            <group string="Status">
                                <field name="pos_cert_status" readonly="1"/>
                                <field name="l10n_at_organization_status" readonly="1"/>
                                <field name="l10n_at_organization_error" invisible="not l10n_at_organization_error"/>
                            </group>
                        </group>
                        <group>
                            <button name="create_organization" 
                                    string="Create Organization" 
                                    type="object" 
                                    class="btn-primary"
                                    invisible="pos_cert_status != 'active' or l10n_at_organization_status == 'created' or l10n_at_organization_status == 'creating'"/>
                            <button name="action_activate_pos_cert" 
                                    string="Activate POS Certification" 
                                    type="object" 
                                    class="btn-primary"
                                    invisible="pos_cert_status != 'inactive'"/>
                            <!-- <button name="cancel_plan" 
                                    string="Cancel Plan" 
                                    type="object" 
                                    class="btn-danger"
                                    invisible="pos_cert_status == 'inactive'"/> -->
                        </group>
                        <div class="alert alert-info" role="alert" invisible="pos_cert_status != 'active' or l10n_at_organization_status == 'created'">
                            <strong>Note:</strong> Click "Create Organization" to set up your Austrian fiscal compliance.
                        </div>
                        
                        <!-- FON Authentication Section -->
                        <group string="FON Authentication" invisible="pos_cert_status != 'active' or l10n_at_organization_status != 'created'">
                            <group string="FON Credentials">
                                <field name="l10n_at_fon_participant_id"/>
                                <field name="l10n_at_fon_user_id"/>
                                <field name="l10n_at_fon_user_pin"/>
                            </group>
                            <group string="Authentication Status">
                                <field name="l10n_at_fon_authentication_status" readonly="1"/>
                                <field name="l10n_at_fon_authentication_date" readonly="1"/>
                                <field name="l10n_at_fon_authentication_error" readonly="1" invisible="not l10n_at_fon_authentication_error"/>
                            </group>
                        </group>
                        <group invisible="pos_cert_status != 'active' or l10n_at_organization_status != 'created'">
                            <button name="action_authenticate_fon" 
                                    string="Authenticate FON" 
                                    type="object" 
                                    class="btn-primary"/>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="pos_cert_status != 'active' or l10n_at_organization_status == 'created'">
                            <strong>FON Authentication:</strong> Enter your FinanzOnline credentials and click "Authenticate FON" to complete the Austrian fiscal compliance setup.
                        </div>
                        
                        <!-- SCU (Signature Creation Unit) Section -->
                        <group string="SCU (Signature Creation Unit)" invisible="pos_cert_status != 'active' or l10n_at_organization_status != 'created'">
                            <group string="SCU Status">
                                <field name="l10n_at_scu_id" readonly="1"/>
                                <field name="l10n_at_scu_status" readonly="1"/>
                                <field name="l10n_at_scu_error" readonly="1" invisible="not l10n_at_scu_error"/>
                                <field name="l10n_at_scu_initialization_error" readonly="1" invisible="not l10n_at_scu_initialization_error"/>
                            </group>
                        </group>
                        <group invisible="pos_cert_status != 'active' or l10n_at_organization_status != 'created'">
                            <button name="action_create_scu" 
                                    string="Create Signature Creation Unit" 
                                    type="object" 
                                    class="btn-primary"
                                    invisible="l10n_at_scu_id"/>
                            <button name="action_initialize_scu" 
                                    string="Initialize SCU" 
                                    type="object" 
                                    class="btn-primary"
                                    invisible="l10n_at_scu_status == 'INITIALIZED' or l10n_at_scu_status == 'PENDING'"/>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="pos_cert_status != 'active' or l10n_at_organization_status != 'pending'">
                            <strong>SCU Creation:</strong> Click "Create Signature Creation Unit" to set up your digital signature unit for Austrian fiscal compliance.
                        </div>
                        <div class="alert alert-info" role="alert" invisible="pos_cert_status != 'active' or l10n_at_organization_status != 'created' or not l10n_at_scu_id or l10n_at_scu_status == 'INITIALIZED' or l10n_at_scu_status == 'DECOMMISSIONED' or l10n_at_scu_status == 'OUTAGE' or l10n_at_scu_status == 'DEFECTIVE'">
                            <strong>SCU Initialization:</strong> Click "Initialize SCU" to activate your digital signature unit for Austrian fiscal compliance. FON authentication is required.
                        </div>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 