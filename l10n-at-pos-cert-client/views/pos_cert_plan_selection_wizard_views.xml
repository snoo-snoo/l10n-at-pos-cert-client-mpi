<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pos_cert_plan_selection_wizard_form_view" model="ir.ui.view">
            <field name="name">pos_cert_plan_selection_wizard.form</field>
            <field name="model">pos_cert_plan_selection_wizard</field>
            <field name="arch" type="xml">
                <form string="Subscribe to POS Certification">
                    <sheet>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <div class="alert alert-info" role="alert">
                                <strong>POS Certification Subscription</strong><br/>
                                Click the Subscribe button below to create a POS certification subscription for this company.
                                You will be redirected to the payment portal after subscription creation.
                            </div>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_subscribe" 
                                string="Subscribe" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Cancel" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo> 