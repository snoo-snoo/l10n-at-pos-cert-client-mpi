<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pos_cert_plan_selection_wizard_form_view" model="ir.ui.view">
            <field name="name">pos_cert_plan_selection_wizard.form</field>
            <field name="model">pos_cert_plan_selection_wizard</field>
            <field name="arch" type="xml">
                <form string="Select POS Certification Plan">
                    <sheet>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="selected_plan_id" 
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Select a plan from the dropdown..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_select_plan" 
                                string="Select Plan" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Cancel" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo> 