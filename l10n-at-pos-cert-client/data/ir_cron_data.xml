<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to retry offline receipts every 5 minutes -->
        <record id="ir_cron_retry_offline_receipts" model="ir.cron">
            <field name="name">Retry Offline POS Receipts</field>
            <field name="model_id" ref="model_pos_receipt"/>
            <field name="state">code</field>
            <field name="code">model._retry_offline_receipts_cron()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo> 